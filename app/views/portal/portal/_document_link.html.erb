<% link_attributes = local_assigns[:link_attributes] || {} %>
<% icon = local_assigns[:icon] || "icons/download.svg" %>
<% link_class = local_assigns[:link_class] || "link" %>
<div class="status-line-items__row">
  <%= image_tag(icon, alt: "") %>
  <%= link_to url, target: "_blank", rel: "noopener", class: link_class, **link_attributes do %>
    <span class="link__border"><%= text %></span>
  <% end %>
</div>
