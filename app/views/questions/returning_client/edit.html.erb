<% @main_heading = t("views.questions.returning_client.title") %>
<% content_for :page_title, @main_heading %>

<section class="slab slab--white question-layout--gyr">
  <div class="grid">
    <div class="grid__item width-three-fourths">
      <div class="main-content-inner">
        <h1 class="form-question">
          <%= @main_heading %>
        </h1>
        <p>
          <%= t("views.questions.returning_client.next_steps_html", :email_link => mail_to("hello@getyourrefund.org")) %>
        <p>

        <%= link_to new_portal_client_login_path, "data-track-click": "login_from_returning_clients", class: "button button--primary text--centered button--wide spacing-above-60" do %>
          <%= t("general.sign_in") %>
        <% end %>
      </div>
    </div>
  </div>
</section>
